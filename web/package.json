{
  "name": "sgl-time-domain-imaging-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "python3 -m pytest tests -q -m \"not slow\" --strict-markers --strict-config -rf",
    "test:slow": "python3 -m pytest tests -q -m slow --strict-markers --strict-config",
    "test:numbers": "bash tools/verify_numbers.sh",
    "test:paper": "bash tools/verify_numbers.sh --with-pdf"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
